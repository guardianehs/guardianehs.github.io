# Header rules for the Guardian application — deployed on Cloudflare Pages
# (guardian-ehs-app.pages.dev). These are the protections a static host on
# GitHub Pages could never set. Cloudflare Pages reads this file automatically
# on every deploy, no configuration needed.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.anthropic.com https://api.openai.com https://openrouter.ai https://api.groq.com https://generativelanguage.googleapis.com https://api.mistral.ai https://api.cerebras.ai http://localhost:* http://127.0.0.1:*

# the app shell must never be served stale after a deploy
/app.html
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/sw.js
  Cache-Control: no-cache, must-revalidate

# fingerprinted assets can be cached hard
/*.png
  Cache-Control: public, max-age=31536000, immutable
